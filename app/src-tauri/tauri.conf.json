{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nanarchive",
  "version": "0.1.0",
  "identifier": "com.nanarchive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nanarchive",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMkQ4OEY2QjJCMEE2NzAKUldSd3ByQ3k5b2d0b0xWUGFlVllhMXF1K3FQK01ScFF4UkYvZXg4eldVVHNUOVFoRjlMYzBad2wK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Nanarchive",
    "copyright": "Nanarchive",
    "shortDescription": "Nanarchive archiver",
    "longDescription": "Nanarchive - an archiver that makes smaller archives than RAR, ZIP and 7z.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
